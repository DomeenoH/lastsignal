<% content_for(:title) { "可信联系人确认 - 失联告警 · LastSignal" } %>

<div class="max-w-xl mx-auto">
  <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
    <h1 class="text-xl font-bold text-gray-900">确认状态</h1>
    <p class="mt-2 text-sm text-gray-600">
      <strong><%= @user.sender_label %></strong> 将你设为可信联系人。若对方平安但暂时无法联系，
      你可以延后自动发送一段时间。
    </p>

    <div class="mt-4 bg-indigo-50 border border-indigo-200 rounded-lg p-4 text-sm text-indigo-700">
      确认后会延后发送 <strong><%= (@trusted_contact.effective_pause_duration_hours / 24.0).round %> 天</strong>。
      你无法查看任何消息。
    </div>

    <div class="mt-6">
      <%= form_with url: trusted_contact_confirm_path(token: params[:token]), method: :post do |f| %>
        <button type="submit" class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
          确认对方平安
        </button>
      <% end %>
    </div>
  </div>
</div>

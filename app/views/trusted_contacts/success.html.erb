<% content_for(:title) { "确认已收到 - LastSignal" } %>

<div class="max-w-xl mx-auto">
  <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
    <h1 class="text-xl font-bold text-gray-900">确认已收到</h1>
    <p class="mt-2 text-sm text-gray-600">
      感谢确认。发送已暂停至
      <strong><%= @trusted_contact.paused_until&.strftime("%Y-%m-%d %H:%M UTC") %></strong>。
    </p>

    <div class="mt-4 text-xs text-gray-500">
      你现在可以关闭此页面。
    </div>
  </div>
</div>

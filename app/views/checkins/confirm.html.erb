<div class="max-w-xl mx-auto bg-white border border-gray-200 rounded-lg p-8 shadow-sm">
  <h1 class="text-2xl font-semibold text-gray-900 mb-3">确认签到</h1>
  <p class="text-gray-600 mb-6">
    确认后会重置签到计时。
  </p>

  <%= form_with url: complete_checkin_path(token: @token), method: :post, class: "flex flex-col gap-4" do %>
    <%= hidden_field_tag :checkin_token, @token %>
    <%= submit_tag "确认签到", class: "inline-flex items-center justify-center px-5 py-2.5 rounded-lg bg-blue-600 text-white font-medium hover:bg-blue-700 transition" %>
    <p class="text-xs text-gray-500">
      如果这不是你发起的操作，可直接关闭此页面。
    </p>
  <% end %>
</div>

<% content_for(:title) { "账户设置 - 失联告警 · LastSignal" } %>

<div class="max-w-2xl mx-auto">
  <h1 class="text-2xl font-bold text-gray-900 mb-8">账户设置</h1>

  <!-- Account Info Card -->
  <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 mb-8">
    <h2 class="text-lg font-medium text-gray-900 mb-4">账户信息</h2>
    
    <dl class="space-y-4">
      <div class="flex justify-between">
        <dt class="text-sm font-medium text-gray-500">邮箱</dt>
        <dd class="text-sm text-gray-900"><%= @user.email %></dd>
      </div>
      <div class="flex justify-between">
        <dt class="text-sm font-medium text-gray-500">称呼</dt>
        <dd class="text-sm text-gray-900"><%= @user.display_name.presence || "未填写" %></dd>
      </div>
      <div class="flex justify-between">
        <dt class="text-sm font-medium text-gray-500">创建时间</dt>
        <dd class="text-sm text-gray-900"><%= @user.created_at.strftime("%Y-%m-%d") %></dd>
      </div>
      <div class="flex justify-between">
        <dt class="text-sm font-medium text-gray-500">审计日志</dt>
        <dd class="text-sm text-gray-900">
          <%= link_to "查看审计日志", audit_path, class: "text-blue-600 hover:text-blue-800" %>
        </dd>
      </div>
      <div class="flex justify-between items-center">
        <dt class="text-sm font-medium text-gray-500">当前状态</dt>
        <dd class="flex items-center gap-3">
          <% status_colors = { "active" => "green", "grace" => "yellow", "cooldown" => "orange", "delivered" => "red", "paused" => "yellow" } %>
          <% color = status_colors[@user.state] || "gray" %>
          <% status_labels = { "active" => "正常", "grace" => "提醒中", "cooldown" => "最终提醒", "delivered" => "已送达", "paused" => "已暂停" } %>
          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-<%= color %>-100 text-<%= color %>-800">
            <%= status_labels[@user.state] || @user.state %>
          </span>

          <% if @user.paused? %>
            <%= form_with url: unpause_dashboard_path, method: :post, class: "inline" do |f| %>
              <button type="submit" class="inline-flex items-center px-2 py-1 text-xs font-medium rounded text-green-700 bg-green-100 hover:bg-green-200">
                <svg class="mr-1 h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"/>
                </svg>
                恢复
              </button>
            <% end %>
          <% elsif !@user.delivered? %>
            <%= form_with url: pause_dashboard_path, method: :post, class: "inline" do |f| %>
              <button type="submit" class="inline-flex items-center px-2 py-1 text-xs font-medium rounded text-yellow-700 bg-yellow-100 hover:bg-yellow-200"
                      onclick="return confirm('暂停签到？在恢复之前不会发送提醒或自动发送消息。')">
                <svg class="mr-1 h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 9v6m4-6v6m7-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
                暂停
              </button>
            <% end %>
          <% end %>
        </dd>
      </div>
    </dl>
  </div>

  <!-- Check-in Settings Card -->
  <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 mb-8">
    <div class="flex items-center justify-between mb-4">
      <h2 class="text-lg font-medium text-gray-900">签到设置</h2>
      <%= link_to "编辑", edit_account_path, class: "text-sm text-blue-600 hover:text-blue-800" %>
    </div>

    <dl class="space-y-4">
      <div>
        <dt class="text-sm font-medium text-gray-500">签到间隔</dt>
        <dd class="mt-1 text-sm text-gray-900">
          每 <strong><%= (@user.effective_checkin_interval_hours / 24.0).round %> 天</strong>
          <% unless @user.checkin_interval_hours %>
            <span class="text-gray-400">(默认)</span>
          <% end %>
        </dd>
        <dd class="mt-1 text-xs text-gray-500">
          系统会按此频率提醒你确认状态。
        </dd>
      </div>

      <div>
        <dt class="text-sm font-medium text-gray-500">提醒次数</dt>
        <dd class="mt-1 text-sm text-gray-900">
          <strong><%= @user.effective_checkin_attempts %> 次</strong>
          <% unless @user.checkin_attempts %>
            <span class="text-gray-400">(默认)</span>
          <% end %>
        </dd>
        <dd class="mt-1 text-xs text-gray-500">
          错过签到后最多会发送的提醒次数。
        </dd>
      </div>

      <div>
        <dt class="text-sm font-medium text-gray-500">提醒间隔</dt>
        <dd class="mt-1 text-sm text-gray-900">
          <strong><%= (@user.effective_checkin_attempt_interval_hours / 24.0).round %> 天</strong>
          <% unless @user.checkin_attempt_interval_hours %>
            <span class="text-gray-400">(默认)</span>
          <% end %>
        </dd>
        <dd class="mt-1 text-xs text-gray-500">
          每次提醒之间的间隔（含最终提醒）。
        </dd>
      </div>

      <% if !@has_active_messages && !@user.paused? && !@user.delivered? %>
        <div class="pt-4 border-t border-gray-200">
          <dt class="text-sm font-medium text-gray-500">下次签到截止</dt>
          <dd class="mt-1 text-sm text-blue-600">
            签到暂缓，直到你为已接受邀请的收件人创建消息
          </dd>
        </div>
      <% elsif @user.paused? %>
        <div class="pt-4 border-t border-gray-200">
          <dt class="text-sm font-medium text-gray-500">下次签到截止</dt>
          <dd class="mt-1 text-sm text-yellow-600">
            签到已暂停
          </dd>
        </div>
      <% elsif @user.next_checkin_at %>
        <div class="pt-4 border-t border-gray-200">
          <dt class="text-sm font-medium text-gray-500">下次签到截止</dt>
          <dd class="mt-1 text-sm text-gray-900">
            <%= @user.next_checkin_at.strftime("%Y-%m-%d %H:%M UTC") %>
            <% if @user.next_checkin_at > Time.current %>
              <span class="text-green-600">（还有 <%= distance_of_time_in_words(Time.current, @user.next_checkin_at) %>）</span>
            <% else %>
              <span class="text-red-600">（已逾期 <%= distance_of_time_in_words(@user.next_checkin_at, Time.current) %>）</span>
            <% end %>
          </dd>
        </div>
      <% end %>
    </dl>
  </div>

  <!-- Trusted Contact Summary -->
  <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 mb-8">
    <div class="flex items-center justify-between mb-4">
      <h2 class="text-lg font-medium text-gray-900">可信联系人</h2>
      <%= link_to "编辑", edit_account_path, class: "text-sm text-blue-600 hover:text-blue-800" %>
    </div>

    <% if @user.trusted_contact.present? %>
      <dl class="space-y-4">
        <div class="flex justify-between">
          <dt class="text-sm font-medium text-gray-500">姓名</dt>
          <dd class="text-sm text-gray-900"><%= @user.trusted_contact.name.presence || "未填写" %></dd>
        </div>
        <div class="flex justify-between">
          <dt class="text-sm font-medium text-gray-500">邮箱</dt>
          <dd class="text-sm text-gray-900"><%= @user.trusted_contact.email %></dd>
        </div>
        <div class="flex justify-between">
          <dt class="text-sm font-medium text-gray-500">暂停时长</dt>
          <dd class="text-sm text-gray-900">
            每次确认 <strong><%= (@user.trusted_contact.effective_pause_duration_hours / 24.0).round %> 天</strong>
          </dd>
        </div>
        <div class="flex justify-between">
          <dt class="text-sm font-medium text-gray-500">上次确认</dt>
          <dd class="text-sm text-gray-900">
            <%= @user.trusted_contact.last_confirmed_at ? @user.trusted_contact.last_confirmed_at.strftime("%Y-%m-%d %H:%M UTC") : "暂无" %>
          </dd>
        </div>
        <div class="flex justify-between">
          <dt class="text-sm font-medium text-gray-500">发送暂停</dt>
          <dd class="text-sm text-gray-900">
            <% if @user.trusted_contact.pause_active? %>
              暂停至 <strong><%= @user.trusted_contact.paused_until.strftime("%Y-%m-%d %H:%M UTC") %></strong>
            <% else %>
              未启用
            <% end %>
          </dd>
        </div>
      </dl>
    <% else %>
      <p class="text-sm text-gray-600">
        尚未配置可信联系人。若你错过最终提醒，我们会联系对方确认是否需要延期发送。
      </p>
    <% end %>
  </div>

  <!-- Emergency Recovery Card -->
  <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 mb-8">
    <h2 class="text-lg font-medium text-gray-900 mb-4">应急恢复</h2>
    
    <p class="text-sm text-gray-600 mb-4">
      恢复码用于在<strong>无法访问邮箱</strong>时紧急停止自动发送。
      如需使用，请访问 <code class="bg-gray-100 px-1 rounded">/emergency</code>。
    </p>

    <% if @user.recovery_code_viewed? %>
      <p class="text-sm text-gray-500 mb-4">
        恢复码上次保存：<%= @user.recovery_code_viewed_at.strftime("%Y-%m-%d") %>
      </p>
    <% else %>
      <p class="text-sm text-yellow-700 bg-yellow-50 p-3 rounded mb-4">
        你尚未保存恢复码，请立即生成。
      </p>
    <% end %>

    <%= button_to "生成新的恢复码", regenerate_recovery_code_account_path,
        method: :post,
        disabled: current_user.delivered?,
        data: { turbo_confirm: "这将使当前恢复码失效，是否继续？" },
        class: "inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 disabled:opacity-50 disabled:cursor-not-allowed" %>
  </div>

  <!-- Danger Zone -->
  <div class="bg-red-50 border border-red-200 rounded-lg p-6">
    <h2 class="text-lg font-medium text-red-900 mb-4">危险区域</h2>
    <p class="text-sm text-red-700 mb-4">
      删除账户将永久移除你的所有消息、收件人和设置。
      此操作无法撤销。
    </p>
    <%= button_to "删除账户", account_path, 
        method: :delete,
        disabled: current_user.delivered?,
        data: { turbo_confirm: "确定要删除账户吗？此操作无法撤销。" },
        class: "inline-flex items-center px-4 py-2 border border-red-300 text-sm font-medium rounded-md text-red-700 bg-white hover:bg-red-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500 disabled:opacity-50 disabled:cursor-not-allowed" %>
  </div>
</div>

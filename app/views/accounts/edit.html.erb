<% content_for(:title) { "编辑设置 - 失联告警 · LastSignal" } %>

<div class="max-w-2xl mx-auto">
  <div class="flex items-center justify-between mb-8">
    <h1 class="text-2xl font-bold text-gray-900">编辑签到设置</h1>
    <%= link_to "取消", account_path, class: "text-sm text-gray-600 hover:text-gray-800" %>
  </div>

  <%= form_with model: @user, url: account_path, method: :patch, class: "space-y-8" do |f| %>
    <% if @user.errors.any? %>
      <div class="bg-red-50 border border-red-200 rounded-lg p-4">
        <h3 class="text-sm font-medium text-red-800">
          <%= @user.errors.count %> 个错误导致无法保存设置：
        </h3>
        <ul class="mt-2 text-sm text-red-700 list-disc list-inside">
          <% @user.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
      <h2 class="text-lg font-medium text-gray-900 mb-6">个人信息</h2>

      <div>
        <%= f.label :display_name, "你的称呼（昵称/真实姓名，可选）", class: "block text-sm font-medium text-gray-700" %>
        <%= f.text_field :display_name,
            placeholder: "例如：张三 / Alex",
            class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm" %>
        <p class="mt-1 text-xs text-gray-500">
          会显示在发给收件人的邮件里，帮助对方识别你。
        </p>
      </div>
    </div>

    <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
      <h2 class="text-lg font-medium text-gray-900 mb-6">时间设置</h2>
      
      <div class="space-y-6">
        <!-- Check-in Interval -->
        <div>
          <%= f.label :checkin_interval_days, "签到间隔", class: "block text-sm font-medium text-gray-700" %>
          <div class="mt-1 flex items-center space-x-2">
            <%= f.number_field :checkin_interval_days,
                min: AppConfig.checkin_min_interval_hours / 24,
                max: AppConfig.checkin_max_interval_hours / 24,
                step: 1,
                value: (@user.checkin_interval_hours ? (@user.checkin_interval_hours / 24.0).round : nil),
                placeholder: AppConfig.checkin_default_interval_hours / 24,
                class: "block w-32 rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm" %>
            <span class="text-sm text-gray-500">天</span>
          </div>
          <p class="mt-1 text-xs text-gray-500">
            你需要确认签到的频率。
            留空使用默认值。若错过签到将发送提醒邮件。
          </p>
        </div>

        <!-- Reminder Attempts -->
        <div>
          <%= f.label :checkin_attempts, "提醒次数", class: "block text-sm font-medium text-gray-700" %>
          <div class="mt-1 flex items-center space-x-2">
            <%= f.number_field :checkin_attempts,
                min: AppConfig.checkin_min_attempts,
                max: AppConfig.checkin_max_attempts,
                step: 1,
                value: @user.checkin_attempts,
                placeholder: AppConfig.checkin_default_attempts,
                class: "block w-32 rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm" %>
            <span class="text-sm text-gray-500">次</span>
          </div>
          <p class="mt-1 text-xs text-gray-500">
            错过签到后发送提醒邮件的次数（包含首次提醒）。
            留空使用默认值。
          </p>
        </div>

        <!-- Attempt Interval -->
        <div>
          <%= f.label :checkin_attempt_interval_days, "提醒间隔", class: "block text-sm font-medium text-gray-700" %>
          <div class="mt-1 flex items-center space-x-2">
            <%= f.number_field :checkin_attempt_interval_days,
                min: AppConfig.checkin_min_attempt_interval_hours / 24,
                max: AppConfig.checkin_max_attempt_interval_hours / 24,
                step: 1,
                value: (@user.checkin_attempt_interval_hours ? (@user.checkin_attempt_interval_hours / 24.0).round : nil),
                placeholder: AppConfig.checkin_default_attempt_interval_hours / 24,
                class: "block w-32 rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm" %>
            <span class="text-sm text-gray-500">天</span>
          </div>
          <p class="mt-1 text-xs text-gray-500">
            错过签到后提醒邮件的间隔。
            留空使用默认值（可信联系人确认后的发送也使用该间隔）。
          </p>
        </div>
      </div>
    </div>

    <!-- Timeline Visualization -->
    <div class="bg-blue-50 border border-blue-200 rounded-lg p-6">
      <h3 class="text-sm font-medium text-blue-800 mb-4">签到流程说明</h3>
      <div class="flex items-center text-xs text-blue-700">
        <div class="flex-1 text-center">
          <div class="font-medium">签到</div>
          <div>↓</div>
        </div>
        <div class="flex-1 text-center border-t-2 border-blue-300 pt-2">
          <div>间隔</div>
          <div class="text-blue-500">(<%= (@user.effective_checkin_interval_hours / 24.0).round %>天)</div>
        </div>
        <div class="flex-1 text-center">
          <div class="font-medium">错过</div>
          <div>↓</div>
        </div>
        <div class="flex-1 text-center border-t-2 border-yellow-400 pt-2">
          <div>提醒次数</div>
          <div class="text-yellow-600">(共 <%= @user.effective_checkin_attempts %> 次)</div>
        </div>
        <div class="flex-1 text-center">
          <div class="font-medium">每隔</div>
          <div>↓</div>
        </div>
        <div class="flex-1 text-center border-t-2 border-orange-400 pt-2">
          <div>间隔</div>
          <div class="text-orange-600">(<%= (@user.effective_checkin_attempt_interval_hours / 24.0).round %>天)</div>
        </div>
        <div class="flex-1 text-center">
          <div class="font-medium text-red-600">发送</div>
        </div>
      </div>
      <p class="mt-4 text-xs text-blue-700">
        从首次提醒到发送的总时长：
        <strong><%= ((@user.effective_checkin_attempts * @user.effective_checkin_attempt_interval_hours) / 24.0).round %> 天</strong>
      </p>
    </div>

    <!-- Trusted Contact -->
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
      <h2 class="text-lg font-medium text-gray-900 mb-2">可信联系人（可选）</h2>
      <p class="text-sm text-gray-600 mb-6">
        可信联系人可以确认你平安但暂时无法联系。他们只能在最后一次提醒后延后发送。
        他们无法读取你的消息或访问你的账户。
      </p>

      <div class="space-y-6">
        <%= f.fields_for :trusted_contact do |tc| %>
          <div class="grid sm:grid-cols-2 gap-6">
            <div>
              <%= tc.label :name, "姓名", class: "block text-sm font-medium text-gray-700" %>
              <%= tc.text_field :name,
                  class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm",
                  placeholder: "Jordan Lee" %>
            </div>
            <div>
              <%= tc.label :email, "邮箱", class: "block text-sm font-medium text-gray-700" %>
              <%= tc.email_field :email,
                  class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm",
                  placeholder: "trusted@example.com" %>
            </div>
          </div>

          <div class="grid sm:grid-cols-2 gap-6">
            <div>
              <%= tc.label :pause_duration_days, "暂停时长", class: "block text-sm font-medium text-gray-700" %>
              <div class="mt-1 flex items-center space-x-2">
                <%= tc.number_field :pause_duration_days,
                    min: AppConfig.trusted_contact_min_pause_duration_hours / 24,
                    max: AppConfig.trusted_contact_max_pause_duration_hours / 24,
                    step: 1,
                    value: (tc.object&.pause_duration_hours ? (tc.object.pause_duration_hours / 24.0).round : nil),
                    placeholder: AppConfig.trusted_contact_default_pause_duration_hours / 24,
                    class: "block w-32 rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm" %>
                <span class="text-sm text-gray-500">天</span>
              </div>
              <p class="mt-1 text-xs text-gray-500">
                每次确认都会将发送延后相同时长。
                留空使用默认值。
              </p>
            </div>
          </div>

          <% if tc.object&.persisted? %>
            <div class="flex items-center space-x-2">
              <%= tc.check_box :_destroy, class: "h-4 w-4 text-red-600 border-gray-300 rounded" %>
              <%= tc.label :_destroy, "移除可信联系人", class: "text-sm text-red-600" %>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>

    <!-- Trusted Contact Flow -->
    <div class="bg-indigo-50 border border-indigo-200 rounded-lg p-6">
      <h3 class="text-sm font-medium text-indigo-800 mb-4">可信联系人流程说明</h3>
      <div class="flex items-center text-xs text-indigo-700">
        <div class="flex-1 text-center">
          <div class="font-medium">最终提醒</div>
          <div>↓</div>
        </div>
        <div class="flex-1 text-center border-t-2 border-indigo-300 pt-2">
          <div>提醒可信联系人</div>
          <div class="text-indigo-500">(每次暂停仅一次)</div>
        </div>
        <div class="flex-1 text-center">
          <div class="font-medium">确认平安</div>
          <div>↓</div>
        </div>
        <div class="flex-1 text-center border-t-2 border-indigo-300 pt-2">
          <div>发送暂停</div>
          <div class="text-indigo-500">(+<%= ((@user.trusted_contact&.effective_pause_duration_hours || AppConfig.trusted_contact_default_pause_duration_hours) / 24.0).round %>天)</div>
        </div>
        <div class="flex-1 text-center">
          <div class="font-medium">暂停结束</div>
          <div>↓</div>
        </div>
        <div class="flex-1 text-center border-t-2 border-indigo-300 pt-2">
          <div>发送</div>
          <div class="text-indigo-500">(+<%= (@user.effective_checkin_attempt_interval_hours / 24.0).round %>天)</div>
        </div>
      </div>
      <p class="mt-4 text-xs text-indigo-700">
        暂停到期后会再次发起确认请求。若你或可信联系人未签到，
        发送将在暂停结束后的一个<strong>“提醒间隔”</strong>内进行。
      </p>
    </div>

    <div class="flex justify-end space-x-4">
      <%= link_to "取消", account_path, class: "px-4 py-2 text-sm font-medium text-gray-700 hover:text-gray-800" %>
      <%= f.submit "保存设置",
          disabled: current_user.delivered?,
          class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed" %>
    </div>
  <% end %>
</div>

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <title><%= content_for(:title) || "LastSignal" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="当你无法按时签到时，把消息安全发送给你关心的人">
    <meta name="robots" content="noindex, nofollow">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-gray-50 text-gray-900">
    <header class="py-6 border-b border-gray-200 bg-white">
      <div class="container mx-auto px-4">
        <div class="flex items-center gap-2">
          <%= image_tag "/logo-mark.svg", class: "w-8 h-8", alt: "LastSignal 标志" %>
          <span class="text-xl font-bold text-gray-900">LastSignal</span>
        </div>
      </div>
    </header>

    <main class="container mx-auto px-4 py-8">
      <% if flash[:notice] %>
        <div class="mb-4 p-4 bg-green-100 border border-green-400 text-green-700 rounded" role="alert">
          <%= flash[:notice] %>
        </div>
      <% end %>

      <% if flash[:alert] %>
        <div class="mb-4 p-4 bg-red-100 border border-red-400 text-red-700 rounded" role="alert">
          <%= flash[:alert] %>
        </div>
      <% end %>

      <%= yield %>
    </main>

    <footer class="mt-auto py-8 text-center text-sm text-gray-500">
      <div class="container mx-auto px-4">
        <div class="p-4 bg-yellow-50 border border-yellow-200 rounded-lg max-w-xl mx-auto">
          <p class="font-medium text-yellow-800">安全提示</p>
          <p class="mt-1 text-yellow-700">
            我们不会通过邮件索要你的密码。密码只会在官网输入。
            在输入敏感信息前，请确认网址无误。
          </p>
        </div>
      </div>
    </footer>
  </body>
</html>

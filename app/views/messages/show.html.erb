<% content_for(:title) { "#{@message.label.presence || '未命名消息'} - 消息 - LastSignal" } %>

<div class="max-w-3xl mx-auto">
  <div class="flex items-center justify-between mb-8">
    <div>
      <nav class="text-sm text-gray-500 mb-2">
        <%= link_to "消息", messages_path, class: "hover:text-gray-700" %> /
      </nav>
      <h1 class="text-2xl font-bold text-gray-900"><%= @message.label.presence || "未命名消息" %></h1>
    </div>
    <div class="flex items-center space-x-4">
      <%= link_to "编辑", edit_message_path(@message), class: "text-sm text-blue-600 hover:text-blue-800" %>
      <%= button_to "删除", message_path(@message),
          method: :delete,
          disabled: current_user.delivered?,
          data: { turbo_confirm: "删除此消息？此操作无法撤销。" },
          class: "text-sm text-red-600 hover:text-red-800 disabled:opacity-50 disabled:cursor-not-allowed" %>
    </div>
  </div>

  <!-- Message Details -->
  <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 mb-6">
    <h2 class="text-lg font-medium text-gray-900 mb-4">详情</h2>
    
    <dl class="space-y-4">
      <div class="flex justify-between">
        <dt class="text-sm font-medium text-gray-500">创建时间</dt>
        <dd class="text-sm text-gray-900"><%= @message.created_at.strftime("%Y-%m-%d %H:%M UTC") %></dd>
      </div>

      <% if @message.updated_at > @message.created_at + 1.minute %>
        <div class="flex justify-between">
          <dt class="text-sm font-medium text-gray-500">最近更新</dt>
          <dd class="text-sm text-gray-900"><%= @message.updated_at.strftime("%Y-%m-%d %H:%M UTC") %></dd>
        </div>
      <% end %>

      <div class="flex justify-between">
        <dt class="text-sm font-medium text-gray-500">加密方式（技术信息）</dt>
        <dd class="text-sm text-gray-900">
          <%= @message.aead_algo %> (v<%= @message.payload_version %>)
        </dd>
      </div>

      <div class="flex justify-between">
        <dt class="text-sm font-medium text-gray-500">消息大小（加密后）</dt>
        <dd class="text-sm text-gray-900">
          <%= number_to_human_size(@message.ciphertext_b64u.bytesize) %>
        </dd>
      </div>
    </dl>
  </div>

  <!-- Encrypted Content Notice -->
  <div class="bg-gray-50 border border-gray-200 rounded-lg p-6 mb-6">
    <div class="flex items-center space-x-3">
      <svg class="h-8 w-8 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
      </svg>
      <div>
        <h3 class="text-sm font-medium text-gray-900">内容已加密</h3>
        <p class="text-sm text-gray-500">
          消息内容已加密，无法显示。只有收件人输入密码才能查看。
        </p>
      </div>
    </div>
  </div>

  <!-- Recipients -->
  <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
    <h2 class="text-lg font-medium text-gray-900 mb-4">
      收件人（<%= @recipients.count %>）
    </h2>
    
    <% if @recipients.any? %>
      <ul class="divide-y divide-gray-200">
        <% @recipients.each do |mr| %>
          <li class="py-3 flex items-center justify-between">
            <div>
              <p class="text-sm font-medium text-gray-900"><%= mr.recipient.display_name %></p>
              <p class="text-xs text-gray-500"><%= mr.recipient.email %></p>
            </div>
            <div class="text-right">
              <% if mr.delivery_delay_days > 0 %>
                <span class="text-xs text-amber-600 block">
                  延迟 <%= mr.delivery_delay_days %> 天
                </span>
              <% end %>
              <span class="text-xs text-gray-400">
                <%= mr.envelope_algo %> v<%= mr.envelope_version %>
              </span>
            </div>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="text-sm text-gray-500">此消息未分配收件人。</p>
    <% end %>
  </div>

  <!-- Delivery Status (if delivered) -->
  <% if current_user.delivered? %>
    <div class="mt-6 bg-green-50 border border-green-200 rounded-lg p-4">
      <h3 class="text-sm font-medium text-green-800">消息已送达</h3>
      <p class="mt-1 text-sm text-green-700">
        该消息已发送给收件人，他们可以通过阅读链接查看。
      </p>
    </div>
  <% end %>
</div>

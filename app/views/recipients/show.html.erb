<% content_for(:title) { "#{@recipient.display_name} - 收件人 - 失联告警 · LastSignal" } %>

<div class="max-w-2xl mx-auto">
  <div class="flex items-center justify-between mb-8">
    <div>
      <nav class="text-sm text-gray-500 mb-2">
        <%= link_to "收件人", recipients_path, class: "hover:text-gray-700" %> /
      </nav>
      <h1 class="text-2xl font-bold text-gray-900"><%= @recipient.display_name %></h1>
    </div>
    <div class="flex items-center space-x-4">
      <% if @recipient.invited? %>
        <%= button_to "重新发送邀请", resend_invite_recipient_path(@recipient),
            method: :post,
            disabled: current_user.delivered?,
            class: "text-sm text-blue-600 hover:text-blue-800 disabled:opacity-50 disabled:cursor-not-allowed" %>
      <% end %>
      <%= button_to "移除", recipient_path(@recipient),
          method: :delete,
          disabled: current_user.delivered?,
          data: { turbo_confirm: "移除 #{@recipient.display_name}？他们将不再收到你的消息。" },
          class: "text-sm text-red-600 hover:text-red-800 disabled:opacity-50 disabled:cursor-not-allowed" %>
    </div>
  </div>

  <!-- Status Card -->
  <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 mb-6">
    <h2 class="text-lg font-medium text-gray-900 mb-4">状态</h2>
    
    <dl class="space-y-4">
      <div class="flex justify-between">
        <dt class="text-sm font-medium text-gray-500">邮箱</dt>
        <dd class="text-sm text-gray-900"><%= @recipient.email %></dd>
      </div>

      <% if @recipient.name.present? %>
        <div class="flex justify-between">
          <dt class="text-sm font-medium text-gray-500">姓名</dt>
          <dd class="text-sm text-gray-900"><%= @recipient.name %></dd>
        </div>
      <% end %>

      <div class="flex justify-between">
        <dt class="text-sm font-medium text-gray-500">状态</dt>
        <dd>
          <% if @recipient.accepted? %>
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
              已接受
            </span>
          <% else %>
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">
              待接受邀请
            </span>
          <% end %>
        </dd>
      </div>

      <div class="flex justify-between">
        <dt class="text-sm font-medium text-gray-500">添加时间</dt>
        <dd class="text-sm text-gray-900"><%= @recipient.created_at.strftime("%Y-%m-%d %H:%M UTC") %></dd>
      </div>

      <% if @recipient.accepted? && @recipient.accepted_at %>
        <div class="flex justify-between">
          <dt class="text-sm font-medium text-gray-500">接受时间</dt>
          <dd class="text-sm text-gray-900"><%= @recipient.accepted_at.strftime("%Y-%m-%d %H:%M UTC") %></dd>
        </div>
      <% end %>

      <% if @recipient.invited? && @recipient.invite_expires_at %>
        <div class="flex justify-between">
          <dt class="text-sm font-medium text-gray-500">邀请到期</dt>
          <dd class="text-sm text-gray-900">
            <%= @recipient.invite_expires_at.strftime("%Y-%m-%d %H:%M UTC") %>
            <% if @recipient.invite_expires_at < Time.current %>
              <span class="text-red-500 text-xs">(已过期 - 请重新发送邀请)</span>
            <% else %>
              <span class="text-gray-400 text-xs">(还有 <%= distance_of_time_in_words(Time.current, @recipient.invite_expires_at) %>)</span>
            <% end %>
          </dd>
        </div>
      <% end %>
    </dl>
  </div>

  <!-- Key Info (if accepted) -->
  <% if @recipient.accepted? && @recipient.recipient_key %>
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 mb-6">
      <h2 class="text-lg font-medium text-gray-900 mb-4">安全设置</h2>
      
      <dl class="space-y-4">
        <div class="flex justify-between">
          <dt class="text-sm font-medium text-gray-500">设置版本</dt>
          <dd class="text-sm text-gray-900">v<%= @recipient.recipient_key.key_version %></dd>
        </div>
        <div class="flex justify-between">
          <dt class="text-sm font-medium text-gray-500">设置时间</dt>
          <dd class="text-sm text-gray-900"><%= @recipient.recipient_key.created_at.strftime("%Y-%m-%d") %></dd>
        </div>
      </dl>

      <div class="mt-4 p-3 bg-green-50 border border-green-200 rounded-md">
        <p class="text-sm text-green-700">
          该收件人已完成设置，可以接收消息并使用密码查看。
        </p>
      </div>
    </div>
  <% end %>

  <!-- Messages assigned to this recipient -->
  <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
    <h2 class="text-lg font-medium text-gray-900 mb-4">消息</h2>
    
    <% if @recipient.messages.any? %>
      <ul class="divide-y divide-gray-200">
        <% @recipient.messages.each do |message| %>
          <li class="py-3">
            <div class="flex items-center justify-between">
              <div>
                <p class="text-sm font-medium text-gray-900">
                  <%= message.label.presence || "未命名消息" %>
                </p>
                <p class="text-xs text-gray-500">创建于 <%= message.created_at.strftime("%Y-%m-%d") %></p>
              </div>
              <%= link_to "查看", message_path(message), class: "text-sm text-blue-600 hover:text-blue-800" %>
            </div>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="text-sm text-gray-500">
        <% if @recipient.accepted? %>
          尚未分配消息。为此收件人<%= link_to "创建消息", new_message_path, class: "text-blue-600 hover:text-blue-800" %>。
        <% else %>
          该收件人需要先接受邀请，才能接收消息。
        <% end %>
      </p>
    <% end %>
  </div>
</div>
